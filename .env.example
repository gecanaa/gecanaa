# Copie para .env e preencha. Os dois valores são públicos por natureza
# (ficam no JavaScript do site); o controle de acesso é feito no Apps Script.

# URL do Web App do Apps Script, terminando em /exec
VITE_API_URL=https://script.google.com/macros/s/AKf.../exec

# ID do cliente OAuth criado no Google Cloud (tipo: aplicativo da Web)
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
